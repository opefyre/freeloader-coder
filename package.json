{
  "name": "pipeline-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start-agent-canvas.mjs",
    "start:services": "node scripts/start.mjs",
    "control-plane": "npm run build && node dist/apps/core/src/control-plane-main.js",
    "agent-canvas:gateway": "node dist/apps/core/src/agent-canvas-model-gateway-main.js",
    "agent-canvas:mcp": "node dist/apps/core/src/pipeline-mcp-main.js",
    "agent-canvas:start": "npm start",
    "repair": "node scripts/setup.mjs --repair",
    "artifacts:identity:preview": "npm run build && node scripts/refresh-governed-identity.mjs",
    "artifacts:identity:apply": "npm run build && node scripts/refresh-governed-identity.mjs --apply",
    "certify:owner-journey": "npm run build && node scripts/certify-owner-journey.mjs",
    "studio:dev": "vite --config apps/studio/vite.config.ts",
    "studio:build": "vite build --config apps/studio/vite.config.ts",
    "studio:budget": "node scripts/studio-budget.mjs",
    "studio:release-check": "npm run build && npm run studio:build && npm run studio:budget",
    "site:dev": "vite --config apps/site/vite.config.ts",
    "site:build": "vite build --config apps/site/vite.config.ts",
    "site:budget": "node scripts/site-budget.mjs",
    "site:release-check": "npm run build && npm run site:build && npm run site:budget",
    "setup:check": "node scripts/setup-check.mjs",
    "format:check": "node scripts/repo-check.mjs format",
    "lint": "node scripts/repo-check.mjs lint",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "verify": "npm run setup:check && npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "vite": "8.1.5"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0"
  }
}
